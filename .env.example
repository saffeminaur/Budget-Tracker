NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never exposed to the browser. Powers the dashboard's
# "Quick add" free-text parsing. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional — defaults to gemini-flash-latest if omitted. Google periodically
# retires specific dated model names for new API keys, so the "-latest"
# alias is the safer default; set this to pin an exact model instead.
# GEMINI_MODEL=gemini-flash-latest
# Optional — a different model/tier, tried once if GEMINI_MODEL is still
# overloaded (503/UNAVAILABLE) after 3 retries with backoff. Defaults to
# gemini-flash-lite-latest. Set equal to GEMINI_MODEL to disable the
# fallback entirely.
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Server-only — powers POST /api/ingest-email (automated bank alert email
# ingestion). Never exposed to the browser.
#
# SUPABASE_SERVICE_ROLE_KEY: from Supabase dashboard > Project Settings >
# API > service_role key. Bypasses Row Level Security — keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# INGEST_USER_ID: your own user UUID, from Supabase dashboard >
# Authentication > Users. All auto-imported entries are written to this
# user, since the endpoint has no login session to derive one from.
INGEST_USER_ID=your-user-uuid
# INGEST_SECRET: any long random string you generate yourself (e.g.
# `openssl rand -hex 32`). The caller (Apps Script) must send this back
# in the `x-ingest-secret` request header, or the request is rejected.
INGEST_SECRET=your-random-secret
# Optional — secures GET /api/ingest-email/retry (see vercel.json), which
# re-attempts any email that hit a transient Gemini outage on first
# ingestion. Vercel Cron sends this automatically as
# `Authorization: Bearer $CRON_SECRET` once the env var is set (cron
# config can't send custom headers, so it can't use INGEST_SECRET
# directly). Without it, the retry route still works when triggered
# manually with the existing x-ingest-secret header.
# CRON_SECRET=another-long-random-secret
